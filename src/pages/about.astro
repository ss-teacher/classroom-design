---
import Layout from '../layouts/Layout.astro';
import { SITE } from '../../site.config.mjs';
// 소개 글은 이 파일에서 직접 고칩니다. 블로그 주소와 메일 주소는 site.config.mjs 에 있습니다.

// 걸어온 길: 묶음 이름과 그 안의 줄들. 줄을 더하거나 빼면 화면에 그대로 반영됩니다.
const history = [
  {
    title: '수상',
    items: [
      ['2024', '경기도 인성교육 실천사례 연구발표대회 1등급 (교육감)'],
      ['2024', '전국 인성교육 실천사례 연구발표대회 3등급'],
      ['2023', '경기도 인성교육 실천사례 연구발표대회 3등급 (교육감)'],
      ['2021', '초등 배움중심수업 활성화 유공 교육감 표창'],
    ],
  },
  {
    title: '강의와 활동',
    items: [
      ['2025', '지식샘터 캔바 사용법 강의'],
      ['2023', '한국과학창의재단 창의교육센터 운영 위촉교사 (지능정보기술 활용 협력지능 수업모델)'],
      ['2023', '파주 미래교육 On-마당 수업나눔 선도교사'],
      ['2023', '전남교육청 에듀테크 기반 디지털·AI 연수 강사'],
    ],
  },
  {
    title: '함께 쓴 책 (공저)',
    items: [
      ['2025', '《가장 쉬운 독학 캔바 첫걸음》 동양북스'],
      ['2025', '《교사들의 에듀테크 활용 Bible》 이티에듀'],
      ['2024', '《틴커캐드로 시작하는 에듀테크 미술 만들기 수업》 박영사'],
    ],
  },
];
---

<Layout title="소개" description="교실행동디자인이 무엇인지, 누가 만들었는지 소개합니다.">
  <article class="wrap wrap--narrow">
    <header class="detail-head">
      <h1 class="page-title">소개</h1>
    </header>

    <section class="section" aria-labelledby="what">
      <h2 class="section-title" id="what">교실행동디자인이란</h2>
      <div class="stack">
        <p>
          교실행동디자인은 학생을 바꾸려 하기 전에, <strong>바람직한 행동이 하기 쉬운 교실을 만드는 일</strong>입니다. 지시와
          통제가 아니라 <strong>구조와 환경</strong>에서 출발합니다.
        </p>
        <p>
          같은 말을 여러 번 해도 달라지지 않는 장면이 있습니다. 그럴 때 "왜 안 할까"보다{' '}
          <strong>"무엇이 이 행동을 어렵게 만들까"</strong>를 먼저 묻습니다. 물건이 놓인 자리, 신호가 보이는 위치, 알려 주는 때,
          첫걸음의 크기, 함께하는 방식 같은 <strong>작은 조건이 행동을 바꾸기도</strong> 합니다.
        </p>
        <p>
          이 사이트는 행동경제학과 심리학의 연구, 그리고 교실에서 해 본 실천을 <strong>교사의 눈으로 정리한 곳</strong>입니다.{' '}
          <strong>교실에서 힘들었던 장면</strong>에서 출발해 왜 그런 행동이 나오는지 살펴보고, 바꿔 볼 방법과 바로 쓸 수 있는
          자료로 이어지도록 만들었습니다.
        </p>
        <p>
          <strong>쉽게·보이게·제때·작게·함께</strong>, 다섯 가지 원리는 검증된 하나의 이론이 아닙니다. 여러 연구와 실천을 교실에서
          떠올리기 좋게 <strong>정리한 틀</strong>입니다.
        </p>
        <p>
          여기 있는 내용은 <strong>정답이 아니라 출발점</strong>입니다. 학년과 학급, 아이들에 따라 맞는 방법이 다르니 우리 반에
          맞게 고쳐 쓰시기 바랍니다.
        </p>
      </div>
    </section>

    <section class="section" aria-labelledby="who">
      <h2 class="section-title" id="who">만든 사람</h2>
      <div class="stack">
        <p>
          안녕하세요, 초등교사 상수쌤입니다. 교실에서 아이들과 지내며 수업과 학급 운영을 기록하고, 선생님들과 나누는 일을 해 왔습니다.
        </p>
        <p>
          인성교육 실천 연구와 에듀테크 수업을 이어 오면서, 아이들의 행동은 마음가짐만큼이나{' '}
          <strong>교실의 구조와 환경에 영향을 받는다</strong>는 것을 자주 보았습니다. 그 경험을 행동경제학과 심리학의 눈으로 다시
          정리해 보려고 교실행동디자인을 시작했습니다.
        </p>
        <p>제가 교실에서 필요했던 것을, <strong>다른 선생님도 바로 꺼내 쓸 수 있게</strong> 나눕니다.</p>
      </div>

      <div class="history">
        {
          history.map((group) => (
            <div class="history__group">
              <h3 class="history__title">{group.title}</h3>
              <ul class="history__list">
                {group.items.map(([when, what]) => (
                  <li>
                    <span class="history__when">{when}</span>
                    <span>{what}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </section>

    <section class="section" aria-labelledby="contact">
      <h2 class="section-title" id="contact">소식과 연락</h2>
      <p class="section-note">
        새 자료와 교실 이야기는 인스타그램에서 먼저 나눕니다. 수업과 학교생활 기록은 블로그에 차곡차곡 모아 둡니다.
      </p>
      <div class="contact__links">
        <a class="btn" href={SITE.instagram} target="_blank" rel="noopener noreferrer">인스타그램 @ss__teacher</a>
        {
          SITE.blog && (
            <a class="btn btn--ghost" href={SITE.blog} target="_blank" rel="noopener noreferrer">
              블로그 · {SITE.blogName}
            </a>
          )
        }
      </div>
      <p class="contact__mail">
        자료에 대한 의견, 고쳐야 할 내용, 강의·원고 문의는 메일로 보내 주세요.
        <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
      </p>
    </section>
  </article>
</Layout>

<style>
  .history {
    display: grid;
    gap: 24px;
    margin-top: 28px;
    padding: 24px;
    background: var(--soft-bg);
    border: 1px solid var(--line);
    border-radius: 16px;
  }
  .history__title {
    font-size: 1rem;
    font-weight: 700;
    color: var(--green);
    margin-bottom: 10px;
  }
  .history__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 8px;
  }
  .history__list li {
    display: grid;
    grid-template-columns: 6.5em 1fr;
    gap: 12px;
    line-height: 1.6;
  }
  .history__when {
    color: var(--ink-soft);
    font-variant-numeric: tabular-nums;
  }
  .contact__links {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .contact__mail {
    margin-top: 20px;
    line-height: 1.7;
  }
  .contact__mail a {
    display: block;
    margin-top: 4px;
    color: var(--green);
    font-weight: 700;
    overflow-wrap: anywhere;
  }
  @media (max-width: 520px) {
    .history {
      padding: 18px;
    }
    .history__list li {
      grid-template-columns: 1fr;
      gap: 0;
    }
  }
</style>
