---
import Layout from '../layouts/Layout.astro';
import { SITE } from '../../site.config.mjs';
// 소개 글은 이 파일에서 직접 고칩니다. [ ] 로 표시한 곳이 나중에 채울 자리입니다.
---

<Layout title="소개" description="교실행동디자인이 무엇인지, 누가 만들었는지 소개합니다.">
  <article class="wrap wrap--narrow">
    <header class="detail-head">
      <h1 class="page-title">소개</h1>
    </header>

    <section class="section" aria-labelledby="what">
      <h2 class="section-title" id="what">교실행동디자인이란</h2>
      <div class="stack">
        <p>
          교실행동디자인은 학생을 바꾸려 하기 전에, 바람직한 행동이 하기 쉬운 교실을 만드는 일입니다. 지시와 통제가 아니라 구조와
          환경에서 출발합니다.
        </p>
        <p>[이 자리에 교실행동디자인을 소개하는 글이 들어갑니다.]</p>
      </div>
    </section>

    <section class="section" aria-labelledby="who">
      <h2 class="section-title" id="who">만든 사람</h2>
      <p>[이 자리에 만든 사람 소개가 들어갑니다.]</p>
    </section>

    <section class="section" aria-labelledby="contact">
      <h2 class="section-title" id="contact">소식과 연락</h2>
      <p class="section-note">새 자료와 교실 이야기는 인스타그램에서 먼저 나눕니다.</p>
      <a class="btn" href={SITE.instagram} target="_blank" rel="noopener noreferrer">인스타그램 @ss__teacher</a>
    </section>
  </article>
</Layout>
