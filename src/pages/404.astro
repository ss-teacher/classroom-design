---
import Layout from '../layouts/Layout.astro';
import { href } from '../lib/data.js';
---

<Layout title="페이지를 찾을 수 없습니다">
  <div class="wrap wrap--narrow">
    <header class="page-head">
      <h1 class="page-title">페이지를 찾을 수 없습니다</h1>
      <p class="page-lead">주소가 바뀌었거나 아직 공개되지 않은 내용일 수 있습니다.</p>
    </header>
    <p style="margin-top:24px">
      <a class="btn" href={href('/')}>첫 화면으로</a>
    </p>
  </div>
</Layout>
