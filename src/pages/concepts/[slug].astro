---
import Layout from '../../layouts/Layout.astro';
import SceneCard from '../../components/SceneCard.astro';
import ResourceCard from '../../components/ResourceCard.astro';
import IdeaList from '../../components/IdeaList.astro';
import { href, concepts, scenesOf, resourcesOf, conceptEmoji } from '../../lib/data.js';

export function getStaticPaths() {
  return concepts.map((concept) => ({ params: { slug: concept.slug }, props: { concept } }));
}
const { concept } = Astro.props;
const scenes = scenesOf(concept);
const resources = resourcesOf(concept);
---

<Layout title={concept.title} description={concept.summary}>
  <article class="wrap wrap--narrow">
    <header class="detail-head">
      <a class="back-link" href={href('/concepts/')}>개념 사전</a>
      <div class="chips">
        {concept.core && <span class="chip">핵심 개념</span>}
        {concept.principles.map((p) => <span class="chip chip--warm">{p}</span>)}
        {concept.field && <span class="chip chip--line">{concept.field}</span>}
        {!concept.published && <span class="chip chip--draft">비공개</span>}
      </div>
      <div class="detail-title-row"><span class="tile tile--lg tile--warm" aria-hidden="true">{conceptEmoji(concept)}</span><h1 class="detail-title">{concept.title}</h1></div>
      {concept.summary && <p class="detail-lead">{concept.summary}</p>}
    </header>

    {
      concept.inClass && (
        <section class="box" aria-labelledby="inclass">
          <h2 class="box__label" id="inclass"><span class="emoji" aria-hidden="true">🏫</span>교실에서는</h2>
          <p>{concept.inClass}</p>
        </section>
      )
    }

    {
      concept.ideas.length > 0 && (
        <section class="section" aria-labelledby="ideas">
          <h2 class="section-title" id="ideas"><span class="emoji" aria-hidden="true">💡</span>교실 적용 아이디어</h2>
          <p class="section-note">정답이 아니라 출발점입니다. 우리 반에 맞게 고쳐 쓰세요.</p>
          <div class="card">
            <IdeaList ideas={concept.ideas} />
          </div>
        </section>
      )
    }

    {
      scenes.length > 0 && (
        <section class="section" aria-labelledby="scenes">
          <h2 class="section-title" id="scenes"><span class="emoji" aria-hidden="true">🧩</span>이 개념이 도움이 되는 장면</h2>
          <div class="stack">
            {scenes.map((s) => <SceneCard scene={s} />)}
          </div>
        </section>
      )
    }

    {
      resources.length > 0 && (
        <section class="section" aria-labelledby="res">
          <h2 class="section-title" id="res"><span class="emoji" aria-hidden="true">🎁</span>관련 자료</h2>
          <p class="section-note">로그인 없이 누구나 바로 받을 수 있습니다.</p>
          <div class="stack">
            {resources.map((r) => <ResourceCard resource={r} tone="dark" />)}
          </div>
        </section>
      )
    }
  </article>
</Layout>
