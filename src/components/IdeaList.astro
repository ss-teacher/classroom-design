---
const { ideas = [] } = Astro.props;
---

{
  ideas.length > 0 && (
    <ul class="ideas">
      {ideas.map((i) => (
        <li>
          <p class="ideas__title">
            {i.teacher && <span class="chip">선생님</span>}
            <span>{i.title}</span>
          </p>
          {i.desc && <p class="ideas__desc">{i.desc}</p>}
        </li>
      ))}
    </ul>
  )
}
